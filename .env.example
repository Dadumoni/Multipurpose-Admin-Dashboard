# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Cloudflare R2 Configuration (S3-Compatible)
R2_ACCOUNT_ID="YOUR_R2_ACCOUNT_ID"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="YOUR_R2_BUCKET_NAME"
R2_PUBLIC_URL="YOUR_R2_PUBLIC_URL"

# MongoDB Configuration
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority"

# ZeroStorage Universal Upload Configuration
ZEROSTORAGE_API_KEY="YOUR_ZEROSTORAGE_API_KEY"

# Deployment & Keep-Alive Configuration
PORT=3000

# External Python Scraper Engine (deployed on Koyeb)
SCRAPER_APP_URL="https://your-site-scrapers.koyeb.app"
