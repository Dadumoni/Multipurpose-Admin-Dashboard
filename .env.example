# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=multipurpose_tool

# ── Cloudflare D1 ─────────────────────────────────────────────────────────────
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_D1_DATABASE_ID=your_d1_database_id
CF_API_TOKEN=your_cloudflare_api_token

# ── Cloudflare R2 (S3-compatible) ─────────────────────────────────────────────
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key
R2_BUCKET=thumbnails
R2_PUBLIC_URL=https://pub-XXXXXXXX.r2.dev   # or your custom domain

# ── Scraper behaviour ─────────────────────────────────────────────────────────
SCRAPE_DELAY=10          # seconds between posts
MONITOR_INTERVAL=86400   # seconds between auto-scans (24h)

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── Keep-alive / Self-ping (Koyeb free tier ke liye) ─────────────────────────
# Apni deployed app ka public URL — deploy karne ke baad set karo
# Format: https://your-service-name-username.koyeb.app
SELF_URL=

# Ping interval seconds me (default: 1740 = 29 minutes)
# Koyeb free tier 30 min inactivity ke baad sleep karta hai
# isliye 29 min set kiya hai (thoda margin)
HEALTH_PING_INTERVAL=1740
